@namespace MyGoodsApp.Pages
@using MudBlazor

<MudDialog>
    <MudDialogTitle>@Series.Name の操作</MudDialogTitle>

    <MudDialogContent>
        <MudList T="object">
            <MudListItem T="object" OnClick="@(() => MudDialog.Close(DialogResult.Ok("edit")))">
                編集
            </MudListItem>

            <MudListItem T="object" OnClick="@(() => MudDialog.Close(DialogResult.Ok("delete")))">
                削除
            </MudListItem>
        </MudList>
    </MudDialogContent>

    <MudDialogActions>
        <MudButton OnClick="@(() => MudDialog.Close(DialogResult.Cancel()))">
            閉じる
        </MudButton>
    </MudDialogActions>
</MudDialog>

@code {
    [CascadingParameter] IDialogReference MudDialog { get; set; } = default!;

    [Parameter]
    public Models.Series Series { get; set; } = default!;
}
