@page "/"
@inject SeriesRepository SeriesRepo
@inject NavigationManager Nav
@inject IDialogService Dialog
@inject IJSRuntime JS

<MudPaper Class="pa-4 mx-auto" MaxWidth="900px" Elevation="4">

    <MudText Typo="Typo.h5" Class="mb-4">作品一覧</MudText>

    @if (seriesList == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudList T="Series" Dense="true">
            @foreach (var s in seriesList)
            {
                <MudListItem T="Series" @key="s.Id">

                    <div id="series-item-@s.Id"
                         @onclick="@(() => Nav.NavigateTo($"/series/{s.Id}/products"))">

                        <MudText>@s.Name</MudText>

                    </div>

                </MudListItem>
            }
        </MudList>
    }

</MudPaper>

<MudIconButton Icon="@Icons.Material.Filled.Add"
               Class="fab-add fab-round"
               OnClick="AddSeriesDialog" />

@code {
    List<Series>? seriesList;

    protected override async Task OnInitializedAsync()
    {
        await LoadSeries();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && seriesList != null)
        {
            foreach (var s in seriesList)
            {
                await JS.InvokeVoidAsync(
                    "longPress.registerById",
                    $"series-item-{s.Id}",
                    DotNetObjectReference.Create(this),
                    s.Id
                );
            }
        }
    }

    private async Task LoadSeries()
    {
        seriesList = await SeriesRepo.GetAll();
    }

    // 長押しイベント
    [JSInvokable]
    public async Task OnLongPress(int seriesId)
    {
        var s = seriesList!.First(x => x.Id == seriesId);
        await OpenSeriesMenu(s);
    }

    private async Task OpenSeriesMenu(Series s)
    {
        var parameters = new DialogParameters
        {
            { "Series", s }
        };

        var dialog = await Dialog.ShowAsync<SeriesMenuDialog>(
            $"{s.Name} の操作",
            parameters
        );

        var result = await dialog.Result;

        if (result.Data is string action)
        {
            if (action == "edit")
                await EditSeriesDialog(s);

            if (action == "delete")
                await DeleteSeries(s);
        }
    }

    private async Task AddSeriesDialog()
    {
        var parameters = new DialogParameters
        {
            { "Series", new Series() }
        };

        var dialog = await Dialog.ShowAsync<MyGoodsApp.Pages.SeriesEditDialog>(
            "新規作品追加",
            parameters
        );

        var result = await dialog.Result;
        if (!result.Canceled)
            await LoadSeries();
    }

    private async Task EditSeriesDialog(Series s)
    {
        var parameters = new DialogParameters
        {
            { "Series", s }
        };

        var dialog = await Dialog.ShowAsync<MyGoodsApp.Pages.SeriesEditDialog>(
            "作品編集",
            parameters
        );

        var result = await dialog.Result;
        if (!result.Canceled)
            await LoadSeries();
    }

    private async Task DeleteSeries(Series s)
    {
        bool? confirm = await Dialog.ShowMessageBoxAsync(
            "確認",
            $"{s.Name} を削除しますか？",
            yesText: "削除",
            cancelText: "キャンセル"
        );

        if (confirm == true)
        {
            await SeriesRepo.Delete(s.Id);
            await LoadSeries();
        }
    }
}
